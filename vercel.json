{
  "version": 2,
  "rewrites": [
    {
      "source": "/alpaca-api/(.*)",
      "destination": "https://paper-api.alpaca.markets/$1"
    },
    {
      "source": "/alpaca-live-api/(.*)",
      "destination": "https://api.alpaca.markets/$1"
    },
    {
      "source": "/alpaca-data/(.*)",
      "destination": "https://data.alpaca.markets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
